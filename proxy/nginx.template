# Main nginx.conf file
worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    server_tokens off;

    # Matches the API's MAX_UPLOAD_BYTES default (5 MB) with headroom for multipart overhead.
    client_max_body_size 6m;

    # HTTPS server (with SSL configuration)
    server {
        listen 8443 ssl;
        server_name $DOMAIN;

        # SSL settings 
        ssl_certificate /etc/nginx/ssl/client.crt;
        ssl_certificate_key /etc/nginx/ssl/client.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;

        # Reverse Proxy Settings
        location / {
            proxy_pass $PROXY_PASS;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # CORS is enforced by the API (ALLOWED_ORIGINS); a wildcard here would bypass it.
        }
    }
}
